{
  "name": "sales/integrated-sales-system",
  "description": "نظام مبيعات متكامل - Integrated Sales Management System",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Sales System Developer",
      "email": "developer@sales.local"
    }
  ],
  "require": {
    "php": ">=7.4",
    "tecnickcom/tcpdf": "^6.6",
    "phpmailer/phpmailer": "^6.8",
    "firebase/php-jwt": "^6.8",
    "monolog/monolog": "^2.8",
    "vlucas/phpdotenv": "^5.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "phpstan/phpstan": "^1.9",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "SalesSystem\\": "src/",
      "SalesSystem\\Api\\": "api/",
      "SalesSystem\\Models\\": "models/"
    },
    "files": [
      "config.php"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs --standard=PSR12 .",
    "fix": "phpcbf --standard=PSR12 .",
    "analyze": "phpstan analyse"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  }
}
